APP_NAME="TOURISM-SALES"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tourism.asafdigital.com

APP_LOCALE=he
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=tourism@asafdigital.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tourism@asafdigital.com
MAIL_FROM_NAME="TOURISM-SALES"

# InforU SMS OTP & Alerts
INFORU_BASIC_AUTH=
INFORU_SENDER=ASAFDIGITAL

# Web Push (VAPID)
VAPID_SUBJECT=mailto:tourism@asafdigital.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional AirLabs API key (airports/destinations work out of the box without a key)
AIRLABS_API_KEY=
